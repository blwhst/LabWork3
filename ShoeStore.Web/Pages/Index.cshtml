@page
@model ShoeStore.Web.Pages.IndexModel
@{ ViewData["Title"] = "Каталог"; }

<h2>Каталог обуви</h2>

<form method="get" class="filters">
    <select name="categoryId" asp-items="Model.Categories" class="form-control">
        <option value="">— Все категории —</option>
    </select>

    <select name="sort" class="form-control">
        <option value="">— Без сортировки —</option>
        <option value="price_asc"  selected="@(Model.Sort == "price_asc")">Цена ↑</option>
        <option value="price_desc" selected="@(Model.Sort == "price_desc")">Цена ↓</option>
        <option value="name_asc"   selected="@(Model.Sort == "name_asc")">Название А→Я</option>
        <option value="name_desc"  selected="@(Model.Sort == "name_desc")">Название Я→А</option>
    </select>

    <input type="text" name="search" value="@Model.Search"
           placeholder="Поиск..." class="form-control" />

    <button type="submit" class="btn btn-primary">Применить</button>
</form>

<div class="catalog">
    @foreach (var p in Model.Products.Items)
    {
        <div class="product-card">
            <img src="~/img/@p.Image" alt="@p.Name" />
            <h3>@p.Name</h3>
            <p class="muted">@p.CategoryName / @p.SubcategoryName</p>
            <p class="muted">@p.Manufacturer</p>
            <p class="price">@p.Price.ToString("N0") ₽</p>
            <a asp-page="/Product" asp-route-id="@p.ProductId"
               class="btn btn-primary">Подробнее</a>
        </div>
    }
</div>

@if (Model.Products.TotalPages > 1)
{
    <div class="pagination">
        @for (int i = 1; i <= Model.Products.TotalPages; i++)
        {
            <a asp-page="/Index"
               asp-route-page="@i"
               asp-route-categoryId="@Model.CategoryId"
               asp-route-sort="@Model.Sort"
               asp-route-search="@Model.Search"
               class="page @(i == Model.Products.Page ? "active" : "")">@i</a>
        }
    </div>
}